{
  "name": "health-show-vue3",
  "version": "3.0.0",
  "scripts": {
    "dev": "node scripts/run-vite-dev.mjs",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:watch": "vue-tsc --noEmit -p tsconfig.json --watch",
    "preview": "vite preview",
    "audit:nav": "node --experimental-specifier-resolution=node tests/navigation-structure.mjs",
    "audit:page-structure": "node tests/page-structure.mjs",
    "audit:structure": "npm run audit:nav && npm run audit:page-structure",
    "audit:preflight": "node tests/preflight.mjs e2e",
    "audit:preflight:pipeline": "node tests/preflight.mjs pipeline",
    "audit:ci": "npm run audit:structure && npm run build",
    "audit:nightly": "npm run test:full",
    "audit:api": "node tests/api/health-smoke.mjs",
    "audit:data": "node tests/api/data-density.mjs",
    "audit:write": "node tests/api/health-write-regression.mjs",
    "audit:auth": "node tests/e2e/auth-session-regression.mjs",
    "audit:e2e": "npm run audit:preflight && node tests/e2e/playwright-audit.mjs",
    "audit:e2e:install": "playwright install chromium",
    "audit:pipeline": "npm run audit:preflight:pipeline && node tests/e2e/health-pipeline-regression.mjs",
    "audit:pipeline-warning": "npm run audit:preflight:pipeline && node tests/e2e/health-warning-pipeline-regression.mjs",
    "audit:all": "npm run test:integration",
    "test:warning-lifecycle": "node --test tests/dashboard-dialogs-level.mjs tests/dashboard-runtime-imports.mjs tests/dashboard-runtime-handled.mjs tests/dashboard-summary.mjs tests/dashboard-warning-level.mjs tests/dashboard-warn-curve.mjs tests/warning-lifecycle.mjs",
    "test:realtime-detail": "node --test tests/realtime-detail-dialog.mjs",
    "test:employee-profile-governance": "node --test tests/employee-profile-information-governance.mjs",
    "test:report-center-export": "node --test tests/report-center-export-state.mjs",
    "test:ai-chat-layout": "node --test tests/ai-chat-layout.mjs",
    "test:frontend-beautification": "node --test tests/frontend-beautification.mjs",
    "test:visual-audit-summary": "node --test tests/visual-audit-summary.mjs",
    "test:performance-triage-summary": "node --test tests/performance-triage-summary.mjs",
    "test:warning-semantics": "node --test tests/health-write-source-semantics.mjs tests/command-center-operational-status.mjs tests/command-center-workflow-contract.mjs tests/dashboard-dialogs-level.mjs tests/dashboard-runtime-imports.mjs tests/dashboard-runtime-handled.mjs tests/dashboard-summary.mjs tests/dashboard-warning-level.mjs tests/dashboard-warn-curve.mjs tests/warning-lifecycle.mjs tests/session-keep-alive.mjs",
    "test:fast": "node scripts/health-test-runner.mjs fast",
    "test:frontend": "node scripts/health-test-runner.mjs frontend",
    "test:integration": "node scripts/health-test-runner.mjs integration",
    "test:full": "node scripts/health-test-runner.mjs full",
    "test:integration:old": "node scripts/health-test-runner.mjs integration --source old",
    "test:integration:new": "node scripts/health-test-runner.mjs integration --source new",
    "test:full:old": "node scripts/health-test-runner.mjs full --source old",
    "test:full:new": "node scripts/health-test-runner.mjs full --source new",
    "audit:data:old": "node scripts/with-env.mjs API_DATA_SOURCE=old API_EXPECT_NON_EMPTY=1 -- npm run audit:data",
    "audit:data:new": "node scripts/with-env.mjs API_DATA_SOURCE=new API_EXPECT_NON_EMPTY=0 -- npm run audit:data",
    "audit:perf:api": "node tests/performance/api-latency.mjs",
    "audit:perf:page": "node tests/performance/page-load.mjs",
    "audit:perf": "npm run audit:perf:api && npm run audit:perf:page",
    "audit:perf:old": "node scripts/with-env.mjs API_DATA_SOURCE=old API_EXPECT_NON_EMPTY=1 -- npm run audit:perf",
    "audit:perf:new": "node scripts/with-env.mjs API_DATA_SOURCE=new API_EXPECT_NON_EMPTY=0 -- npm run audit:perf",
    "audit:visual": "node tests/visual/page-layout-audit.mjs",
    "audit:visual:dashboard-full": "node tests/visual/dashboard-full-page-capture.mjs",
    "audit:visual:windows-desktop": "node scripts/with-env.mjs VISUAL_VIEWPORT_PROFILE=windows-desktop-matrix -- npm run audit:visual",
    "audit:visual:windows-desktop-scroll": "node scripts/with-env.mjs VISUAL_VIEWPORT_PROFILE=windows-desktop-matrix VISUAL_SCROLL_AUDIT=1 -- npm run audit:visual",
    "audit:quality:code": "node tests/quality/code-health.mjs",
    "audit:product": "node tests/product/ux-competitor-benchmark.mjs",
    "test:perf": "node scripts/health-test-runner.mjs perf",
    "test:perf:old": "node scripts/health-test-runner.mjs perf --source old",
    "test:perf:new": "node scripts/health-test-runner.mjs perf --source new",
    "test:quality": "node scripts/health-test-runner.mjs quality"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@vue/shared": "^3.5.28",
    "axios": "^1.6.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "element-plus": "^2.6.0",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.0",
    "marked": "^18.0.0",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "path-to-regexp": "^6.2.1",
    "three": "^0.180.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuex": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "sass": "^1.75.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.3.10"
  }
}
